dir_lim="/etc/kyt/limit"

function convert() {
    local -i bytes=$1;
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( (bytes + 1023)/1024 ))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( (bytes + 1048575)/1048576 ))MB"
    else
        echo "$(( (bytes + 1073741823)/1073741824 ))GB"
    fi
}

# ================================================================
#  HELPERS — SSH
# ================================================================

function _create_ssh() (
  user="${1}"; Pass="${2}"; iplimit="${3}"; masaaktif="${4}"

  if ! [[ $user =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Username tidak valid. Gunakan huruf, angka, atau underscore." }'
    exit 1
  fi
  if id "$user" &>/dev/null; then
    echo "{ \"status\": false, \"statusCode\": 409, \"message\": \"Username '$user' sudah terdaftar, gunakan username lain.\" }"
    exit 1
  fi
  if [[ -z "$Pass" ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Password tidak boleh kosong." }'
    exit 1
  fi
  if ! [[ ${masaaktif} =~ ^[0-9]+$ && ${iplimit} =~ ^[0-9]+$ ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Limit IP dan Expired harus berupa angka." }'
    exit 1
  fi

  if [[ $iplimit -gt 0 ]]; then
    mkdir -p ${dir_lim}/ssh/ip/
    echo "$iplimit" > ${dir_lim}/ssh/ip/$user
  fi

  useradd -e $(date -d "$masaaktif days" +"%Y-%m-%d") -s /bin/false -M $user
  echo -e "$Pass\n$Pass\n" | passwd $user &>/dev/null

  hariini=$(date -d "0 days" +"%Y-%m-%d")
  exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

  DATADB=$(grep "^###" /etc/ssh/.ssh.db 2>/dev/null | grep -w "$user" | awk '{print $2}')
  [[ "$DATADB" != '' ]] && sed -i "/\b${user}\b/d" /etc/ssh/.ssh.db
  echo "### ${user} ${Pass} ${iplimit} ${exp} ${hariini}" >> /etc/ssh/.ssh.db

  systemctl restart ssh

  source /usr/local/style/style-all.sh ssh api
)

function _trial_ssh() (
  iplimit="${1}"; waktu="${2}"

  if ! [[ ${waktu} =~ ^[0-9]+$ && ${iplimit} =~ ^[0-9]+$ ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Limit IP dan Waktu harus berupa angka." }'
    exit 1
  fi
  if [[ $waktu -le 0 ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Waktu trial harus lebih dari 0 menit." }'
    exit 1
  fi

  user="trial-$(</dev/urandom tr -dc 0-9 | head -c4)"
  Pass=1; masaaktif=1

  if [[ $iplimit -gt 0 ]]; then
    mkdir -p ${dir_lim}/ssh/ip/
    echo "$iplimit" > ${dir_lim}/ssh/ip/$user
  fi

  useradd -e $(date -d "$masaaktif days" +"%Y-%m-%d") -s /bin/false -M $user
  echo -e "$Pass\n$Pass\n" | passwd $user &>/dev/null

  hariini=$(date -d "0 days" +"%Y-%m-%d")
  exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

  DATADB=$(grep "^###" /etc/ssh/.ssh.db 2>/dev/null | grep -w "$user" | awk '{print $2}')
  [[ "$DATADB" != '' ]] && sed -i "/\b${user}\b/d" /etc/ssh/.ssh.db
  echo "### ${user} ${Pass} ${iplimit} ${exp} ${hariini}" >> /etc/ssh/.ssh.db

  echo "killusr ssh ${user}" | at now + $waktu minutes &>/dev/null

  systemctl restart ssh

  source /usr/local/style/style-all.sh ssh api
)

function _member_ssh() {
  members=()

  while IFS=: read -r username _ uid _ _ _ _; do
    [[ "$username" == "nobody" || ! "$uid" =~ ^[0-9]+$ || "$uid" -lt 1000 ]] && continue

    expiry=$(chage -l "$username" 2>/dev/null | awk -F": " '/Account expires/{print $2}')
    [[ -z "$expiry" ]] && expiry="Never"

    status=$(passwd -S "$username" 2>/dev/null | awk '{print $2}')
    [[ "$status" == "L" ]] && status_val="locked" || status_val="unlocked"

    members+=("{ \"username\": \"${username}\", \"expired\": \"${expiry}\", \"status\": \"${status_val}\" }")
  done < /etc/passwd

  if [[ ${#members[@]} -eq 0 ]]; then
    echo '{ "status": true, "statusCode": 200, "message": "No existing clients.", "data": [] }'
    return
  fi

  echo '{ "status": true, "statusCode": 200, "message": "SUCCESS", "data": ['
  total=${#members[@]}
  for ((i = 0; i < total; i++)); do
    comma=","
    [[ $((i + 1)) -eq $total ]] && comma=""
    echo "  ${members[$i]}${comma}"
  done
  echo '] }'
}

function _delete_ssh() (
  username="${1}"

  if [[ -z "${username}" ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Username tidak boleh kosong." }'
    exit 1
  fi

  if ! getent passwd "${username}" > /dev/null 2>&1; then
    echo "{ \"status\": false, \"statusCode\": 404, \"message\": \"Username '${username}' tidak ditemukan.\" }"
    exit 1
  fi

  exp=$(grep -w "^### ${username}" "/etc/ssh/.ssh.db" | cut -d ' ' -f 5 | sort | uniq)

  userdel "${username}" > /dev/null 2>&1
  sed -i "/^${username}:/d" /etc/group
  grep -wE "^### ${username}" "/etc/ssh/.ssh.db" | awk '{print $1" "$2" "$3}' | sort | uniq | tail -1 >> /etc/xray/.userall.db
  sed -i "/^### ${username}/d" /etc/ssh/.ssh.db
  rm -f /etc/ssh/${username}
  rm -f /etc/kyt/limit/ssh/ip/${username}
  rm -f /var/www/html/ssh-${username}.txt

  echo "{ \"status\": true, \"statusCode\": 200, \"message\": \"SUCCESS\", \"data\": { \"username\": \"${username}\", \"expired\": \"${exp}\" } }"
)

