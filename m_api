  if ! [[ ${Quota} =~ ^[0-9]+$ && ${masaaktif} =~ ^[0-9]+$ && ${iplimit} =~ ^[0-9]+$ ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Quota, Limit IP, dan Expired harus berupa angka." }'
    exit 1
  fi

  exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
  hariini=$(date -d "0 days" +"%Y-%m-%d")
  uuid=$(cat /proc/sys/kernel/random/uuid)

  add_trojan_user

  source /usr/local/style/style-all.sh format_trojan

  [ ! -d /etc/trojan ] && mkdir -p /etc/trojan
  if [[ $iplimit -gt 0 ]]; then
    mkdir -p ${dir_lim}/trojan/ip
    echo "$iplimit" > ${dir_lim}/trojan/ip/$user
  fi

  [ -z "$Quota" ] && Quota="0"
  quotausr=$(echo "$Quota" | sed 's/[^0-9]*//g')
  d=$(( quotausr * 1024 * 1024 * 1024 ))
  [[ $quotausr != "0" ]] && echo "$d" > /etc/trojan/$user

  DATADB=$(grep "^###" /etc/trojan/.trojan.db 2>/dev/null | grep -w "$user" | awk '{print $2}')
  [[ "$DATADB" != '' ]] && sed -i "/\b${user}\b/d" /etc/trojan/.trojan.db
  echo "### ${user} ${exp} ${uuid} ${Quota} ${iplimit}" >> /etc/trojan/.trojan.db

  systemctl restart xray

  source /usr/local/style/style-all.sh trojan api
)

function _trial_trojan() (
  Quota="${1}"; iplimit="${2}"; waktu="${3}"

  if ! [[ ${Quota} =~ ^[0-9]+$ && ${waktu} =~ ^[0-9]+$ && ${iplimit} =~ ^[0-9]+$ ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Quota, Limit IP, dan Waktu harus berupa angka." }'
    exit 1
  fi
  if [[ $waktu -le 0 ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Waktu trial harus lebih dari 0 menit." }'
    exit 1
  fi

  user="trial-$(</dev/urandom tr -dc 0-9 | head -c4)"
  uuid=$(cat /proc/sys/kernel/random/uuid)
  masaaktif=1
  exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
  hariini=$(date -d "0 days" +"%Y-%m-%d")

  add_trojan_user

  source /usr/local/style/style-all.sh format_trojan

  [ ! -d /etc/trojan ] && mkdir -p /etc/trojan
  if [[ $iplimit -gt 0 ]]; then
    mkdir -p ${dir_lim}/trojan/ip
    echo "$iplimit" > ${dir_lim}/trojan/ip/$user
  fi

  [ -z "$Quota" ] && Quota="0"
  quotausr=$(echo "$Quota" | sed 's/[^0-9]*//g')
  d=$(( quotausr * 1024 * 1024 * 1024 ))
  [[ $quotausr != "0" ]] && echo "$d" > /etc/trojan/$user

  DATADB=$(grep "^###" /etc/trojan/.trojan.db 2>/dev/null | grep -w "$user" | awk '{print $2}')
  [[ "$DATADB" != '' ]] && sed -i "/\b${user}\b/d" /etc/trojan/.trojan.db
  echo "### ${user} ${exp} ${uuid} ${Quota} ${iplimit}" >> /etc/trojan/.trojan.db

  echo "killusr trojan ${user}" | at now + $waktu minutes &>/dev/null

  systemctl restart xray

  source /usr/local/style/style-all.sh trojan api
)

function _member_trojan() {
  if [[ "$(grep -c -E '^#! ' '/etc/xray/config.json')" == '0' ]]; then
    echo '{ "status": true, "statusCode": 200, "message": "No existing clients.", "data": [] }'
    return
  fi

  usernames=($(grep -E "^#! " "/etc/xray/config.json" | cut -d ' ' -f 2 | sort | uniq))

  echo '{ "status": true, "statusCode": 200, "message": "SUCCESS", "data": ['

  total=${#usernames[@]}
  for ((i = 0; i < total; i++)); do
    username="${usernames[$i]}"
    exp=$(grep -wE "^#! ${username}" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)

    [[ ! -f "/etc/usr/${username}" ]] && echo "unlock" > /etc/usr/${username}

    log_usage="/etc/usage_quota/trojan/${username}"
    if [[ ! -e "$log_usage" ]]; then
      usage_total="0"
    else
      usage=$(cat "$log_usage")
      usage_total=$(convert "$usage")
    fi

    if [[ "$(cat /etc/usr/${username})" == "unlock" ]]; then
      status_val="unlocked"
    else
      status_val="locked"
    fi

    comma=","
    [[ $((i + 1)) -eq $total ]] && comma=""

    printf '    { "no": %d, "username": "%s", "expired": "%s", "status": "%s", "usage": "%s" }%s\n' \
      "$((i + 1))" "$username" "$exp" "$status_val" "$usage_total" "$comma"
  done

  echo '] }'
}

function _delete_trojan() (
  username="${1}"

  if [[ -z "${username}" ]]; then
    echo '{ "status": false, "statusCode": 400, "message": "Username tidak boleh kosong." }'
    exit 1
  fi

  if [[ "$(grep -c -E '^#! ' '/etc/xray/config.json')" == '0' ]]; then
    echo '{ "status": false, "statusCode": 404, "message": "No existing clients." }'
    exit 1
  fi

  found=$(grep -E "^#! ${username} " "/etc/xray/config.json" | cut -d ' ' -f 2 | sort | uniq)
  if [[ "${found}" != "${username}" ]]; then
    echo "{ \"status\": false, \"statusCode\": 404, \"message\": \"Username '${username}' tidak ditemukan.\" }"
    exit 1
  fi

  exp=$(grep -E "^#! ${username} " "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)

  killusr trojan "${username}" 2>/dev/null

  echo "{ \"status\": true, \"statusCode\": 200, \"message\": \"SUCCESS\", \"data\": { \"username\": \"${username}\", \"expired\": \"${exp}\" } }"
)

# ================================================================
#  ROUTER UTAMA
#  $1 = action  (create | trial | member | delete)
#  $2 = type    (ssh | vmess | vless | trojan)
#  $3... = args
# ================================================================

ACTION="${1}"
TYPE="${2}"

function _usage() {
  cat <<EOF
{ "status": false, "statusCode": 400, "message": "Usage: m_api <create|trial|member|delete> <ssh|vmess|vless|trojan> [args...]" }
EOF
  exit 1
}

function _usage_type() {
  cat <<EOF
{ "status": false, "statusCode": 400, "message": "Tipe tidak dikenal: '$TYPE'. Gunakan: ssh, vmess, vless, trojan." }
EOF
  exit 1
}

case "$ACTION" in
  create) case "$TYPE" in
      ssh) _create_ssh "${3}" "${4}" "${5}" "${6}" ;;
      vmess) _create_vmess "${3}" "${4}" "${5}" "${6}" ;;
      vless) _create_vless "${3}" "${4}" "${5}" "${6}" ;;
      trojan) _create_trojan "${3}" "${4}" "${5}" "${6}" ;;
      *) _usage_type ;;
    esac
    ;;
  trial)
    case "$TYPE" in
      ssh)    _trial_ssh    "${3}" "${4}" ;;
      vmess)  _trial_vmess  "${3}" "${4}" "${5}" ;;
      vless)  _trial_vless  "${3}" "${4}" "${5}" ;;
      trojan) _trial_trojan "${3}" "${4}" "${5}" ;;
      *)      _usage_type ;;
    esac
    ;;

  member)
    case "$TYPE" in
      ssh)    _member_ssh ;;
      vmess)  _member_vmess ;;
      vless)  _member_vless ;;
      trojan) _member_trojan ;;
      *)      _usage_type ;;
    esac
    ;;

  delete)
    case "$TYPE" in
      ssh)    _delete_ssh    "${3}" ;;
      vmess)  _delete_vmess  "${3}" ;;
      vless)  _delete_vless  "${3}" ;;
      trojan) _delete_trojan "${3}" ;;
      *)      _usage_type ;;
    esac
    ;;

  *) _usage ;;
esac
